# XR Collab Backend Environment Variables

# Server Configuration
PORT=10000
NODE_ENV=development

# Redis (Upstash)
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:YOUR_PASSWORD@your-redis-host.upstash.io:6379

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=xr-collab-storage
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_account_id.r2.dev

# JWT Secret (for authentication)
JWT_SECRET=your_random_secret_key_here_change_in_production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://xr-collab.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
