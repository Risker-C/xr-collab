{
  "name": "xr-collab-backend",
  "description": "XR Collab 实时协作平台后端服务",
  "version": "1.0.0",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "deploy": {
    "port": 3001,
    "healthcheck": "/health",
    "resources": {
      "cpu": "1000m",
      "memory": "2Gi",
      "storage": "10Gi"
    },
    "scaling": {
      "min": 1,
      "max": 3,
      "cpu_threshold": 70,
      "memory_threshold": 80
    }
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "3001",
    "UPLOAD_MAX_SIZE": "50mb",
    "STORAGE_PATH": "/app/storage"
  },
  "volumes": [
    {
      "name": "storage",
      "path": "/app/storage",
      "size": "10Gi"
    }
  ],
  "services": [
    {
      "name": "redis",
      "image": "redis:7-alpine",
      "port": 6379,
      "env": {
        "REDIS_URL": "redis://redis:6379"
      }
    }
  ]
}